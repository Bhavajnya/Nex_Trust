      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700;800&family=JetBrains+Mono:wght@500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --navy: oklch(0.18 0.07 270);\n    --navy-2: oklch(0.23 0.07 270);\n    --indigo: oklch(0.52 0.24 277);\n    --indigo-glow: oklch(0.62 0.22 277);\n    --cyan-glow: oklch(0.74 0.14 210);\n    --emerald-brand: oklch(0.71 0.17 162);\n    --font-display: \"Sora\", sans-serif;\n    --font-sans: \"Inter\", sans-serif;\n    --font-mono: \"JetBrains Mono\", monospace;\n  }\n\n  body {\n    margin: 0;\n    font-family: var(--font-sans);\n    background: white;\n    color: oklch(0.18 0.05 265);\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .hero-orb {\n    position: absolute;\n    border-radius: 9999px;\n    filter: blur(80px);\n    opacity: 0.55;\n    pointer-events: none;\n    animation: orb-float 14s ease-in-out infinite;\n  }\n\n  @keyframes orb-float {\n    0%, 100% { transform: translate(0,0) scale(1); }\n    50% { transform: translate(30px, -20px) scale(1.08); }\n  }\n\n  .glass-card {\n    background: color-mix(in oklab, white 8%, transparent);\n    border: 1px solid color-mix(in oklab, white 18%, transparent);\n    backdrop-filter: blur(18px) saturate(140%);\n    border-radius: 1.25rem;\n  }\n\n  .btn-pill-primary {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.5rem;\n    padding: 0.75rem 1.5rem;\n    border-radius: 9999px;\n    background: var(--indigo);\n    color: white;\n    font-weight: 600;\n    transition: all 0.25s ease;\n    box-shadow: 0 8px 24px -8px color-mix(in oklab, var(--indigo) 60%, transparent);\n    cursor: pointer;\n    border: none;\n  }\n\n  .btn-pill-primary:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 12px 28px -8px color-mix(in oklab, var(--indigo) 70%, transparent);\n  }\n\n  .input-field {\n    width: 100%;\n    padding: 1rem;\n    border: 1px solid #E2E8F0;\n    border-radius: 0.875rem;\n    background: white;\n    outline: none;\n    transition: all 0.2s;\n    font-family: var(--font-sans);\n  }\n\n  .input-field:focus {\n    border-color: var(--indigo);\n    box-shadow: 0 0 0 3px color-mix(in oklab, var(--indigo) 15%, transparent);\n  }\n\n  .floating-label-group {\n    position: relative;\n    margin-bottom: 1.25rem;\n  }\n\n  .floating-label {\n    position: absolute;\n    left: 1rem;\n    top: 50%;\n    transform: translateY(-50%);\n    color: #64748B;\n    pointer-events: none;\n    transition: all 0.2s;\n    font-size: 0.875rem;\n  }\n\n  .input-field:focus + .floating-label,\n  .input-field:not(:placeholder-shown) + .floating-label {\n    top: -0.5rem;\n    left: 0.75rem;\n    background: white;\n    padding: 0 0.25rem;\n    font-size: 0.75rem;\n    color: var(--indigo);\n    font-weight: 600;\n  }\n</style>\n\n<div class=\"min-h-screen grid lg:grid-cols-2\" data-kid=\"1\">\n  \n  <div class=\"relative overflow-hidden hidden lg:flex flex-col justify-center px-16 xl:px-24\" style=\"background: linear-gradient(135deg, var(--navy), var(--navy-2));\" data-kid=\"2\">\n    \n    <div class=\"hero-orb\" style=\"width: 520px; height: 520px; background: var(--indigo); top: -120px; left: -120px;\" data-kid=\"3\"></div>\n    <div class=\"hero-orb\" style=\"width: 480px; height: 480px; background: var(--cyan-glow); bottom: -160px; right: -100px; animation-delay: -4s;\" data-kid=\"4\"></div>\n    \n    <div class=\"relative z-10\" data-kid=\"5\">\n      <div class=\"flex items-center gap-2 font-bold text-xl text-white mb-12\" style=\"font-family: var(--font-display);\" data-kid=\"6\">\n        <i class=\"ti ti-shield-check text-2xl\" style=\"color: var(--cyan-glow);\" data-kid=\"7\"></i> Magic Handshake\n      </div>\n      \n      <h1 class=\"text-5xl font-extrabold text-white leading-[1.15] mb-6\" style=\"font-family: var(--font-display);\" data-kid=\"8\">\n        Welcome back.<br data-kid=\"9\">Your escrow's right where you left it.\n      </h1>\n      <p class=\"text-lg text-slate-300 max-w-md mb-12\" data-kid=\"10\">Resume jobs in progress, review AI verifications, and release payments — all in one secure place.</p>\n      \n      \n      <div class=\"glass-card p-6 max-w-sm\" data-kid=\"11\">\n        <div class=\"flex items-center justify-between mb-4\" data-kid=\"12\">\n          <div class=\"text-[10px] font-bold text-white/50 uppercase tracking-widest\" style=\"font-family: var(--font-mono);\" data-kid=\"13\">Active Job #8421</div>\n          <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-500/30\" data-kid=\"14\">\n            Awaiting Verification\n          </span>\n        </div>\n        <div class=\"flex items-center gap-3 mb-6\" data-kid=\"15\">\n          <div class=\"h-10 w-10 rounded-full bg-white/10 flex items-center justify-center border border-white/20\" data-kid=\"16\">\n            <i class=\"ti ti-building-skyscraper text-white\" data-kid=\"17\"></i>\n          </div>\n          <div data-kid=\"18\">\n            <div class=\"text-sm font-bold text-white\" data-kid=\"19\">High-Rise Electrical Fix</div>\n            <div class=\"text-xs text-white/60\" data-kid=\"20\">Worker: @electra_pro</div>\n          </div>\n        </div>\n        <div class=\"flex items-center justify-between pt-4 border-t border-white/10\" data-kid=\"21\">\n          <span class=\"text-[10px] font-medium text-white/40 flex items-center gap-1.5\" style=\"font-family: var(--font-mono);\" data-kid=\"22\">\n            <i class=\"ti ti-lock-access text-cyan-400\" data-kid=\"23\"></i> 0x8f2a…c821\n          </span>\n          <span class=\"text-sm font-bold text-white\" data-kid=\"24\">$1,250.00</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"flex items-center justify-center p-8 sm:p-12 lg:p-24 bg-white\" data-kid=\"25\">\n    <div class=\"w-full max-w-md\" data-kid=\"26\">\n      <div class=\"lg:hidden flex items-center gap-2 font-bold text-xl mb-12\" style=\"font-family: var(--font-display); color: var(--navy);\" data-kid=\"27\">\n        <i class=\"ti ti-shield-check text-2xl\" style=\"color: var(--indigo);\" data-kid=\"28\"></i> Magic Handshake\n      </div>\n\n      <div class=\"mb-10\" data-kid=\"29\">\n        <h2 class=\"text-3xl font-extrabold mb-2\" style=\"font-family: var(--font-display); color: var(--navy);\" data-kid=\"30\">Sign in</h2>\n        <p class=\"text-slate-500\" data-kid=\"31\">Secure access to your Magic Handshake portal.</p>\n      </div>\n\n      <form onsubmit=\"return false;\" class=\"space-y-4\" data-kid=\"32\">\n        <div class=\"floating-label-group\" data-kid=\"33\">\n          <input type=\"email\" class=\"input-field\" placeholder=\" \" id=\"email\" required data-kid=\"34\">\n          <label for=\"email\" class=\"floating-label\" data-kid=\"35\">Email address</label>\n        </div>\n\n        <div class=\"floating-label-group\" data-kid=\"36\">\n          <input type=\"password\" class=\"input-field\" placeholder=\" \" id=\"password\" required data-kid=\"37\">\n          <label for=\"password\" class=\"floating-label\" data-kid=\"38\">Password</label>\n        </div>\n\n        <div class=\"flex items-center justify-between text-sm mb-6\" data-kid=\"39\">\n          <label class=\"flex items-center gap-2 cursor-pointer text-slate-600\" data-kid=\"40\">\n            <input type=\"checkbox\" class=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\" data-kid=\"41\">\n            Keep me signed in\n          </label>\n          <a href=\"#\" class=\"font-semibold text-indigo-600 hover:text-indigo-700 transition\" data-kid=\"42\">Forgot password?</a>\n        </div>\n\n        <button type=\"submit\" class=\"btn-pill-primary w-full text-base py-3.5\" data-kid=\"43\">\n          Sign in to NexTrust\n        </button>\n\n        <div class=\"relative py-6\" data-kid=\"44\">\n          <div class=\"absolute inset-0 flex items-center\" data-kid=\"45\"><div class=\"w-full border-t border-slate-100\" data-kid=\"46\"></div></div>\n          <div class=\"relative flex justify-center text-xs uppercase tracking-widest font-bold text-slate-400\" data-kid=\"47\"><span class=\"bg-white px-4\" data-kid=\"48\">Or continue with</span></div>\n        </div>\n\n        <button type=\"button\" class=\"w-full inline-flex items-center justify-center gap-3 px-6 py-3 border-2 border-slate-100 rounded-2xl font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-200 transition\" data-kid=\"49\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" data-kid=\"50\"><path fill=\"#4285F4\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" data-kid=\"51\"></path><path fill=\"#34A853\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" data-kid=\"52\"></path><path fill=\"#FBBC05\" d=\"M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.83z\" data-kid=\"53\"></path><path fill=\"#EA4335\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z\" data-kid=\"54\"></path></svg>\n          Google Account\n        </button>\n      </form>\n\n      <p class=\"mt-10 text-center text-sm text-slate-500\" data-kid=\"55\">\n        New to NexTrust? <a href=\"/sign-up\" class=\"font-bold text-indigo-600 hover:underline\" data-kid=\"56\">Create a secure account</a>\n      </p>\n\n      \n      <div class=\"mt-16 flex items-center justify-center gap-6 opacity-40 grayscale\" data-kid=\"57\">\n        <i class=\"ti ti-shield-lock text-2xl\" data-kid=\"58\"></i>\n        <i class=\"ti ti-database-leak text-2xl\" data-kid=\"59\"></i>\n        <i class=\"ti ti-lock-square-rounded text-2xl\" data-kid=\"60\"></i>\n      </div>\n    </div>\n  </div>\n</div>",
