      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&family=JetBrains+Mono:wght@500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: var(--navy);\n    color: white;\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-display { font-family: 'Sora', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  /* Replicating HeroOrbs from ui-bits.tsx */\n  .hero-orb-wrapper {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  /* Segments for password strength */\n  .strength-bar {\n    height: 4px;\n    border-radius: 999px;\n    background: color-mix(in oklab, white 10%, transparent);\n    transition: all 0.3s ease;\n  }\n  .strength-bar.active {\n    background: var(--emerald-brand);\n    box-shadow: 0 0 8px var(--emerald-brand);\n  }\n\n  .input-group {\n    position: relative;\n    margin-bottom: 1.25rem;\n  }\n\n  .input-field {\n    width: 100%;\n    padding: 1rem 1.25rem;\n    background: color-mix(in oklab, white 5%, transparent);\n    border: 1px solid color-mix(in oklab, white 15%, transparent);\n    border-radius: 1rem;\n    color: white;\n    outline: none;\n    transition: all 0.2s ease;\n    font-size: 0.9375rem;\n  }\n\n  .input-field:focus {\n    border-color: var(--indigo);\n    background: color-mix(in oklab, white 8%, transparent);\n    box-shadow: 0 0 0 4px color-mix(in oklab, var(--indigo) 20%, transparent);\n  }\n\n  .input-label {\n    position: absolute;\n    left: 1.25rem;\n    top: 50%;\n    transform: translateY(-50%);\n    color: var(--slate-text);\n    pointer-events: none;\n    transition: all 0.2s ease;\n    font-size: 0.9375rem;\n  }\n\n  .input-field:focus + .input-label,\n  .input-field:not(:placeholder-shown) + .input-label {\n    top: -0.5rem;\n    left: 1rem;\n    font-size: 0.75rem;\n    padding: 0 0.5rem;\n    background: var(--navy-2);\n    color: var(--cyan-glow);\n    border-radius: 0.25rem;\n  }\n</style>\n\n<div class=\"relative min-h-screen flex items-center justify-center p-6 bg-[var(--navy)]\" data-kid=\"1\">\n  \n  <div class=\"hero-orb-wrapper\" data-kid=\"2\">\n    <div class=\"hero-orb\" style=\"width: 600px; height: 600px; background: var(--indigo); top: -200px; left: -200px;\" data-kid=\"3\"></div>\n    <div class=\"hero-orb\" style=\"width: 500px; height: 500px; background: var(--cyan-glow); bottom: -200px; right: -100px; animation-delay: -4s;\" data-kid=\"4\"></div>\n    <div class=\"hero-orb\" style=\"width: 400px; height: 400px; background: var(--indigo-glow); top: 30%; left: 60%; opacity: 0.2; animation-delay: -8s;\" data-kid=\"5\"></div>\n  </div>\n\n  \n  <main class=\"relative z-10 w-full max-w-lg animate-fade-up\" data-kid=\"6\">\n    <div class=\"glass-card p-8 md:p-12 border border-white/10 shadow-2xl\" data-kid=\"7\">\n      \n      \n      <div class=\"flex flex-col items-center mb-8\" data-kid=\"8\">\n        <div class=\"h-14 w-14 rounded-2xl bg-gradient-to-br from-[var(--indigo)] to-[var(--cyan-glow)] p-[1px] mb-4\" data-kid=\"9\">\n          <div class=\"h-full w-full rounded-2xl bg-[var(--navy)] flex items-center justify-center\" data-kid=\"10\">\n            <i class=\"ti ti-shield-check text-3xl text-[var(--cyan-glow)]\" data-kid=\"11\"></i>\n          </div>\n        </div>\n        <h1 class=\"font-display text-3xl font-bold tracking-tight text-white mb-2\" data-kid=\"12\">Join NexTrust</h1>\n        <p class=\"text-[var(--slate-text)] text-sm text-center\" data-kid=\"13\">Secure escrow for every handshake, powered by AI.</p>\n      </div>\n\n      \n      <div class=\"flex items-center justify-between mb-8 pb-6 border-b border-white/5\" data-kid=\"14\">\n        <button class=\"inline-flex items-center gap-2 text-xs font-semibold text-[var(--cyan-glow)] hover:text-white transition-colors group\" data-kid=\"15\">\n          <i class=\"ti ti-arrow-left transition-transform group-hover:-translate-x-1\" data-kid=\"16\"></i> \n          <span class=\"font-mono tracking-widest uppercase\" data-kid=\"17\">Change Role</span>\n        </button>\n        <div class=\"font-mono text-[10px] tracking-[0.2em] text-[var(--slate-text)] uppercase px-3 py-1 rounded-full bg-white/5 border border-white/5\" data-kid=\"18\">\n          Step 02: Worker Profile\n        </div>\n      </div>\n\n      \n      <form class=\"space-y-6\" data-kid=\"19\">\n        <div class=\"input-group\" data-kid=\"20\">\n          <input type=\"text\" id=\"full-name\" class=\"input-field\" placeholder=\" \" required data-kid=\"21\">\n          <label for=\"full-name\" class=\"input-label\" data-kid=\"22\">Full Name</label>\n        </div>\n\n        <div class=\"input-group\" data-kid=\"23\">\n          <input type=\"email\" id=\"email\" class=\"input-field\" placeholder=\" \" required data-kid=\"24\">\n          <label for=\"email\" class=\"input-label\" data-kid=\"25\">Email Address</label>\n        </div>\n\n        <div class=\"space-y-2\" data-kid=\"26\">\n          <div class=\"input-group mb-0\" data-kid=\"27\">\n            <input type=\"password\" id=\"password\" class=\"input-field\" placeholder=\" \" required data-kid=\"28\">\n            <label for=\"password\" class=\"input-label\" data-kid=\"29\">Create Password</label>\n            <i class=\"ti ti-lock absolute right-4 top-1/2 -translate-y-1/2 text-white/20\" data-kid=\"30\"></i>\n          </div>\n          \n          \n          <div class=\"pt-2\" data-kid=\"31\">\n            <div class=\"flex items-center justify-between mb-1.5\" data-kid=\"32\">\n              <span class=\"text-[10px] font-bold text-[var(--slate-text)] uppercase tracking-wider\" data-kid=\"33\">Security Strength</span>\n              <span class=\"text-[10px] font-bold text-[var(--emerald-brand)] uppercase tracking-wider\" data-kid=\"34\">Strong</span>\n            </div>\n            <div class=\"grid grid-cols-4 gap-2\" data-kid=\"35\">\n              <div class=\"strength-bar active\" data-kid=\"36\"></div>\n              <div class=\"strength-bar active\" data-kid=\"37\"></div>\n              <div class=\"strength-bar active\" data-kid=\"38\"></div>\n              <div class=\"strength-bar\" data-kid=\"39\"></div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"pt-4\" data-kid=\"40\">\n          <button type=\"submit\" class=\"btn-pill-primary w-full group relative overflow-hidden\" data-kid=\"41\">\n            <span class=\"relative z-10 flex items-center justify-center gap-3\" data-kid=\"42\">\n              Create Secure Account\n              <i class=\"ti ti-arrow-right text-lg transition-transform group-hover:translate-x-1\" data-kid=\"43\"></i>\n            </span>\n            <div class=\"absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]\" data-kid=\"44\"></div>\n          </button>\n          \n          <p class=\"mt-6 text-center text-xs text-[var(--slate-text)]\" data-kid=\"45\">\n            By joining, you agree to our <a href=\"#\" class=\"text-white hover:text-[var(--cyan-glow)] underline underline-offset-4 decoration-white/20\" data-kid=\"46\">Terms</a> and <a href=\"#\" class=\"text-white hover:text-[var(--cyan-glow)] underline underline-offset-4 decoration-white/20\" data-kid=\"47\">Privacy Policy</a>.\n          </p>\n        </div>\n      </form>\n    </div>\n\n    \n    <div class=\"mt-8 flex items-center justify-center gap-6 opacity-40\" data-kid=\"48\">\n      <div class=\"flex items-center gap-2 grayscale hover:grayscale-0 transition-all cursor-default\" data-kid=\"49\">\n        <i class=\"ti ti-lock-square-rounded text-xl\" data-kid=\"50\"></i>\n        <span class=\"font-mono text-[10px] tracking-widest uppercase\" data-kid=\"51\">AES-256 Escrow</span>\n      </div>\n      <div class=\"flex items-center gap-2 grayscale hover:grayscale-0 transition-all cursor-default\" data-kid=\"52\">\n        <i class=\"ti ti-robot text-xl\" data-kid=\"53\"></i>\n        <span class=\"font-mono text-[10px] tracking-widest uppercase\" data-kid=\"54\">AI Verified</span>\n      </div>\n    </div>\n  </main>\n</div>\n\n<style data-kid=\"55\">\n  @keyframes shimmer {\n    100% { transform: translateX(100%); }\n  }\n</style>",
