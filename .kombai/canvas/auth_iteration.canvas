      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Sora:wght@600;700&family=JetBrains+Mono:wght@500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-sans { font-family: 'Inter', sans-serif; }\n  .font-display { font-family: 'Sora', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .btn-pill-primary {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.5rem;\n    padding: 0.75rem 1.5rem;\n    border-radius: 9999px;\n    background: var(--indigo);\n    color: white;\n    font-weight: 600;\n    transition: all 0.25s ease;\n    box-shadow: 0 8px 24px -8px color-mix(in oklab, var(--indigo) 60%, transparent);\n    cursor: pointer;\n    border: none;\n  }\n  .btn-pill-primary:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 12px 28px -8px color-mix(in oklab, var(--indigo) 70%, transparent);\n  }\n\n  .btn-pill-ghost {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.5rem;\n    padding: 0.7rem 1.45rem;\n    border-radius: 9999px;\n    border: 1px solid color-mix(in oklab, var(--cyan-glow) 60%, transparent);\n    color: var(--cyan-glow);\n    font-weight: 600;\n    transition: all 0.25s ease;\n    cursor: pointer;\n    background: transparent;\n  }\n  .btn-pill-ghost:hover {\n    background: color-mix(in oklab, var(--cyan-glow) 10%, transparent);\n  }\n\n  .btn-escrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.6rem 1.25rem;\n    border-radius: 9999px;\n    font-size: 0.875rem;\n    font-weight: 700;\n    background: color-mix(in oklab, var(--cyan-glow) 12%, white);\n    color: color-mix(in oklab, var(--cyan-glow) 70%, black);\n    box-shadow: 0 0 0 1px color-mix(in oklab, var(--cyan-glow) 35%, transparent);\n    transition: all 0.2s ease;\n    cursor: pointer;\n    border: none;\n  }\n  .btn-escrow:hover {\n    box-shadow: 0 0 0 2px var(--cyan-glow), 0 0 12px color-mix(in oklab, var(--cyan-glow) 40%, transparent);\n  }\n\n  .btn-destructive {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.75rem 1.5rem;\n    border-radius: 0.75rem;\n    background: var(--destructive);\n    color: white;\n    font-weight: 600;\n    transition: all 0.2s ease;\n    cursor: pointer;\n    border: none;\n  }\n  .btn-destructive:hover {\n    background: color-mix(in oklab, var(--destructive) 90%, black);\n  }\n\n  .btn-loading {\n    opacity: 0.7;\n    pointer-events: none;\n  }\n\n  .btn-disabled {\n    opacity: 0.4;\n    cursor: not-allowed;\n    pointer-events: none;\n    filter: grayscale(1);\n  }\n\n</style>\n\n<div class=\"p-12 font-sans bg-white min-h-screen\" data-kid=\"1\">\n  <div class=\"max-w-4xl mx-auto\" data-kid=\"2\">\n    <header class=\"mb-12\" data-kid=\"3\">\n      <h1 class=\"text-3xl font-bold font-display text-(--navy)\" data-kid=\"4\">Interactive Button System</h1>\n      <p class=\"text-(--slate-text) mt-2\" data-kid=\"5\">NexTrust's core interactive components and visual states.</p>\n    </header>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12\" data-kid=\"6\">\n      <section data-kid=\"7\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-(--slate-text) mb-6 font-mono\" data-kid=\"8\">Primary Actions</h3>\n        <div class=\"flex flex-col gap-4 items-start\" data-kid=\"9\">\n          <button class=\"btn-pill-primary\" data-kid=\"10\">\n            <i class=\"ti ti-plus\" data-kid=\"11\"></i> New Transaction\n          </button>\n          \n          <button class=\"btn-pill-primary btn-loading\" data-kid=\"12\">\n            <i class=\"ti ti-loader-2 animate-spin\" data-kid=\"13\"></i> Processing...\n          </button>\n          \n          <button class=\"btn-pill-primary btn-disabled\" data-kid=\"14\">\n            Confirm Payment\n          </button>\n        </div>\n      </section>\n\n      <section data-kid=\"15\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-(--slate-text) mb-6 font-mono\" data-kid=\"16\">Ghost & Outline</h3>\n        <div class=\"flex flex-col gap-4 items-start\" data-kid=\"17\">\n          <button class=\"btn-pill-ghost\" data-kid=\"18\">\n            <i class=\"ti ti-settings\" data-kid=\"19\"></i> Manage Escrow\n          </button>\n          \n          <button class=\"btn-pill-ghost btn-loading\" data-kid=\"20\">\n            <i class=\"ti ti-loader-3 animate-spin\" data-kid=\"21\"></i> Loading\n          </button>\n          \n          <button class=\"btn-pill-ghost btn-disabled\" data-kid=\"22\">\n            Action Restricted\n          </button>\n        </div>\n      </section>\n\n      <section data-kid=\"23\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-(--slate-text) mb-6 font-mono\" data-kid=\"24\">High-Trust / Escrow</h3>\n        <div class=\"flex flex-col gap-4 items-start\" data-kid=\"25\">\n          <button class=\"btn-escrow\" data-kid=\"26\">\n            <i class=\"ti ti-lock\" data-kid=\"27\"></i> Fund Secure Escrow\n          </button>\n          \n          <button class=\"btn-escrow\" style=\"background: var(--navy); color: var(--cyan-glow); box-shadow: 0 0 0 1px var(--cyan-glow);\" data-kid=\"28\">\n            <i class=\"ti ti-shield-check\" data-kid=\"29\"></i> AI Verify Now\n          </button>\n        </div>\n      </section>\n\n      <section data-kid=\"30\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-(--slate-text) mb-6 font-mono\" data-kid=\"31\">Utility & Alerts</h3>\n        <div class=\"flex flex-col gap-4 items-start\" data-kid=\"32\">\n          <button class=\"btn-destructive\" data-kid=\"33\">\n            <i class=\"ti ti-trash\" data-kid=\"34\"></i> Delete Account\n          </button>\n          \n          <button class=\"text-(--indigo) font-semibold hover:underline flex items-center gap-1 cursor-pointer\" data-kid=\"35\">\n            <i class=\"ti ti-arrow-right\" data-kid=\"36\"></i> View Documentation\n          </button>\n        </div>\n      </section>\n    </div>\n    \n    <div class=\"mt-16 p-8 rounded-3xl bg-(--navy) border border-(--navy-2) relative overflow-hidden\" data-kid=\"37\">\n      <div class=\"relative z-10\" data-kid=\"38\">\n        <h3 class=\"text-white font-display text-xl mb-6\" data-kid=\"39\">Dark Context Preview</h3>\n        <div class=\"flex flex-wrap gap-4\" data-kid=\"40\">\n          <button class=\"btn-pill-primary\" data-kid=\"41\">Secure Portal</button>\n          <button class=\"btn-pill-ghost\" data-kid=\"42\">View Assets</button>\n          <button class=\"btn-escrow\" data-kid=\"43\">\n            <i class=\"ti ti-lock\" data-kid=\"44\"></i> Cryptographic Sign\n          </button>\n        </div>\n      </div>\n      <div class=\"absolute -top-24 -right-24 w-64 h-64 bg-(--indigo) opacity-30 blur-[80px] rounded-full pointer-events-none\" data-kid=\"45\"></div>\n    </div>\n  </div>\n</div>",
