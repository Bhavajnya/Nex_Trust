# Magic Handshake Frontend Environment Configuration (Vite)

# API Configuration
VITE_API_URL=http://localhost:3001/api

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Vercel Blob Configuration (for evidence storage)
VITE_BLOB_BASE_URL=https://your-blob.vercel-storage.com

# App Configuration
VITE_ENV=development
VITE_APP_NAME=Magic Handshake
VITE_VERSION=0.1.0

# Feature Flags
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEBUG_LOGS=true

# Firebase Emulator (dev only)
VITE_USE_FIREBASE_EMULATOR=false

# Network Configuration
VITE_API_TIMEOUT=30000
VITE_REQUEST_RETRY_ATTEMPTS=3
VITE_REQUEST_RETRY_DELAY=1000
